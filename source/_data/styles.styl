// ============================================
// NexT 自定义样式 —— 全站动态背景 + 毛玻璃阅读背景 + 昼夜切换
// 修改后需要 hexo clean && hexo generate 生效
// ============================================

// 动效总开关：改成 false 即可关掉全部背景动效
$bg-motion = true

// 动态人物层方案（三选一）：
//   'webp'  → 动画 WebP 图片层（默认）——人物会动，且是图片不是视频，
//             浏览器/微信QQ内核不会嗅探出"下载/投屏"工具条
//   'video' → 动态壁纸视频层（人物会动，但部分浏览器会套自带工具条）
//   'none'  → 只要静态图（仅保留环境光与花瓣动效）
// ※ 切换后请同步处理 body-end.swig 顶部对应段落的注释
$bg-media = 'webp'

// 樱花点击特效：点击/触摸处绽开一簇樱花花瓣
// 改成 false 关掉后，请同步注释掉 body-end.swig 末尾的樱花点击脚本
$click-sakura = true

// 背景纱罩：叠在 bg.png 上面的一层纯色半透明纱，
// 把背景图整体压柔和，与文章阅读区拉开对比度
:root {
  --bg-veil: rgba(255, 255, 255, .5);   // 白天：白纱提亮背景
}

// ============================================
// 动态背景：分层互不干扰
//   body         → 底色（铺满、兜底）
//   body::before → bg.png 静态图片层（z-index 最低）
//   .bg-ambient  → 环境光动效层（纯 CSS：柔光带 + 散景光斑）
//   .bg-video    → 动态壁纸视频层（$bg-video = true 时才启用）
//   body::after  → 纱罩层（静止，保证对比度恒定）
//   .bg-petals   → 落樱花瓣层
// ============================================
body {
  background: var(--body-bg-color);
}

body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -3;
  background: url('/images/bg.png') center center / cover no-repeat;
}

// 动态人物层：铺满、居中裁剪；资源就绪后淡入，避免生硬闪现
// （$bg-media = 'webp' 时启用：动画 WebP 图片，会被浏览器当普通图片处理）
if $bg-media == 'webp' {
  .bg-media {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1.2s ease;
    }

    &.is-ready img {
      opacity: 1;
    }
  }
}

// 动态壁纸视频层（$bg-media = 'video' 时启用）
if $bg-media == 'video' {
  .bg-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;

    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1.2s ease;
    }

    &.is-ready video {
      opacity: 1;
    }
  }
}

body::after {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: var(--bg-veil);
  pointer-events: none;
}

if $bg-motion {

  // ---------- 环境光动效层（纯 CSS，制造"空气在流动"的自然感） ----------
  // 不用整张图缩放，改由两束柔光缓慢漂移来体现，画面本体保持稳定不晕
  .bg-ambient {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;

    // 第一层：斜向柔光带，缓慢横扫 + 明暗轻微呼吸，像日光/薄雾在流动
    &::before {
      content: '';
      position: absolute;
      top: -20%;
      left: -60%;
      width: 220%;
      height: 140%;
      background: linear-gradient(
        105deg,
        rgba(255, 255, 255, 0) 30%,
        rgba(255, 255, 255, .34) 46%,
        rgba(255, 238, 246, .46) 52%,
        rgba(255, 255, 255, .28) 58%,
        rgba(255, 255, 255, 0) 72%
      );
      animation: ambient-sweep 46s ease-in-out infinite alternate;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }

    // 第二层：散景光斑（大颗、柔软、极慢漂浮，制造景深与空气感）
    &::after {
      content: '';
      position: absolute;
      top: -10%;
      left: -10%;
      width: 120%;
      height: 120%;
      background-image:
        radial-gradient(circle at 22% 30%, rgba(255, 226, 238, .5) 0, rgba(255, 226, 238, .16) 22%, rgba(255, 226, 238, 0) 42%),
        radial-gradient(circle at 74% 22%, rgba(255, 241, 247, .46) 0, rgba(255, 241, 247, .13) 18%, rgba(255, 241, 247, 0) 38%),
        radial-gradient(circle at 62% 76%, rgba(255, 214, 232, .4) 0, rgba(255, 214, 232, .11) 20%, rgba(255, 214, 232, 0) 40%);
      animation: ambient-bokeh 68s ease-in-out infinite alternate;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
  }

  @keyframes ambient-sweep {
    0% {
      transform: translate3d(-14%, 0, 0);
      opacity: .55;
    }

    100% {
      transform: translate3d(14%, 1.5%, 0);
      opacity: .9;
    }
  }

  @keyframes ambient-bokeh {
    0% {
      transform: translate3d(-1.6%, 1.2%, 0) scale(1);
      opacity: .7;
    }

    100% {
      transform: translate3d(1.8%, -1.4%, 0) scale(1.06);
      opacity: 1;
    }
  }

  // ---------- 落樱花瓣 ----------
  .bg-petals {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  // 花瓣本体：位置/大小/时长由 body-end.swig 里的脚本随机生成
  .bg-petal {
    position: absolute;
    top: -12vh;
    display: block;
    border-radius: 60% 12% 60% 12%;
    background: linear-gradient(135deg, rgba(255, 214, 226, .95), rgba(255, 168, 196, .85));
    box-shadow: 0 0 6px rgba(255, 170, 200, .35);
    opacity: 0;
    animation-name: petal-fall;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  @keyframes petal-fall {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
      opacity: 0;
    }

    12% {
      opacity: var(--petal-opacity, .85);
    }

    85% {
      opacity: var(--petal-opacity, .85);
    }

    100% {
      transform: translate3d(var(--drift, 60px), 122vh, 0) rotate(var(--spin, 420deg));
      opacity: 0;
    }
  }
}

// 无障碍：系统开启"减少动态效果"时全部静止，只留静态图
@media (prefers-reduced-motion: reduce) {
  .bg-video,
  .bg-media,
  .bg-ambient {
    display: none;
  }

  .bg-petal {
    animation: none !important;
  }
}

// ============================================
// 樱花点击特效
// 画布由 body-end.swig 末尾的脚本动态插入，关键样式已由脚本内联
// （免疫 CSS 缓存不命中的混合状态）；这里的规则是等价冗余兜底
// ============================================
if $click-sakura {
  .click-sakura {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2147483000;
    pointer-events: none;
  }
}

// ============================================
// 毛玻璃阅读背景：文章主体列加半透明面板 + 背景模糊，
// 文字浮在毛玻璃上，与背景图彻底分离，阅读更清晰
// ============================================
.content-wrap {
  background: rgba(255, 255, 255, .72);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  backdrop-filter: blur(16px) saturate(150%);
  border-radius: 10px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, .1);
  padding: 24px 36px 30px;

  +mobile() {
    border-radius: 0;
    padding: 20px;
  }
}

// Muse 方案默认 .content 有 70px 顶部留白，面板自带内边距后适当收紧
.content {
  padding-top: 36px;

  +mobile() {
    padding-top: 20px;
  }
}

// 顶栏改为半透明 + 毛玻璃，让背景透出来
.header-inner {
  background: rgba(255, 255, 255, .8);
  -webkit-backdrop-filter: blur(12px) saturate(150%);
  backdrop-filter: blur(12px) saturate(150%);
}

// 页脚也垫一层薄玻璃，保证页脚文字可读
.footer-inner {
  background: rgba(255, 255, 255, .55);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  border-radius: 10px;
}

// 评论等白色区块也改为半透明 + 毛玻璃
.comments {
  background: rgba(255, 255, 255, .8) !important;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

// ============================================
// 昼夜切换按钮支持
// 主题 7.8.0 原生暗色只跟系统自动切换（prefers-color-scheme），
// 这里补上对 data-theme="dark" 手动切换的支持
// ============================================
if hexo-config('darkmode') {

  // 手动切到夜间模式：应用主题暗色变量
  html[data-theme='dark'] {
    --body-bg-color: $body-bg-color-dark;
    --content-bg-color: $content-bg-color-dark;
    --card-bg-color: $card-bg-color-dark;
    --text-color: $text-color-dark;
    --blockquote-color: $blockquote-color-dark;
    --link-color: $link-color-dark;
    --link-hover-color: $link-hover-color-dark;
    --brand-color: $brand-color-dark;
    --brand-hover-color: $brand-hover-color-dark;
    --table-row-odd-bg-color: $table-row-odd-bg-color-dark;
    --table-row-hover-bg-color: $table-row-hover-bg-color-dark;
    --menu-item-bg-color: $menu-item-bg-color-dark;
    --btn-default-bg: $btn-default-bg-dark;
    --btn-default-color: $btn-default-color-dark;
    --btn-default-border-color: $btn-default-border-color-dark;
    --btn-default-hover-bg: $btn-default-hover-bg-dark;
    --btn-default-hover-color: $btn-default-hover-color-dark;
    --btn-default-hover-border-color: $btn-default-hover-border-color-dark;

    // 夜间：深色纱罩压暗背景图
    --bg-veil: rgba(16, 18, 26, .6);

    // 半透明区块的暗色版（毛玻璃同步适配）
    .header-inner {
      background: rgba(40, 40, 40, .8);
    }

    .content-wrap {
      background: rgba(28, 31, 40, .72);
      box-shadow: 0 4px 20px rgba(0, 0, 0, .45);
    }

    .footer-inner {
      background: rgba(40, 43, 52, .6);
    }

    // 夜间：花瓣压暗，避免发白发亮
    .bg-petal {
      background: linear-gradient(135deg, rgba(255, 213, 228, .5), rgba(214, 140, 175, .4));
      box-shadow: none;
    }

    // 夜间：环境光整体压暗，避免屏幕发灰发亮
    .bg-ambient {
      opacity: .38;
    }

    .comments {
      background: rgba(40, 40, 40, .8) !important;
    }

    // 图片压暗（与主题自动暗色行为一致）
    img {
      opacity: .75;

      &:hover {
        opacity: .9;
      }
    }
  }

  // 系统是暗色但用户手动选了白天：强制亮色变量
  html[data-theme='light'] {
    --body-bg-color: $body-bg-color;
    --content-bg-color: $content-bg-color;
    --card-bg-color: $card-bg-color;
    --text-color: $text-color;
    --blockquote-color: $blockquote-color;
    --link-color: $link-color;
    --link-hover-color: $link-hover-color;
    --brand-color: $brand-color;
    --brand-hover-color: $brand-hover-color;
    --table-row-odd-bg-color: $table-row-odd-bg-color;
    --table-row-hover-bg-color: $table-row-hover-bg-color;
    --menu-item-bg-color: $menu-item-bg-color;
    --btn-default-bg: $btn-default-bg;
    --btn-default-color: $btn-default-color;
    --btn-default-border-color: $btn-default-border-color;
    --btn-default-hover-bg: $btn-default-hover-bg;
    --btn-default-hover-color: $btn-default-hover-color;
    --btn-default-hover-border-color: $btn-default-hover-border-color;
  }
}

// ============================================
// 悬浮切换按钮本体（样式从内联挪到这里，方便昼夜适配）
// ============================================
#darkmode-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .2);
  cursor: pointer;
  font-size: 20px;
  line-height: 44px;
  padding: 0;
  transition: background .3s, transform .2s;

  &:hover {
    transform: scale(1.08);
  }

  &:active {
    transform: scale(.95);
  }
}

html[data-theme='dark'] #darkmode-btn {
  background: #333;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .5);
}

// ============================================
// 文章头图（banner）：scripts/banner.js 会把 front-matter 里
// 的 banner 图片插到文章正文顶部，样式在此控制
// 用法：文章 front-matter 加 banner: /images/xxx.jpg
// ============================================
// 头图紧贴标题区：抵消 .post-body 默认的上外边距，避免标题与头图之间出现大片空白
.post-body > .post-banner:first-child {
  margin-top: -12px;
}

.post-banner {
  position: relative;
  margin: 0 0 28px;
  // 默认 21:9 宽幅自适应高度；文章 front-matter 里 banner_height: 320 可改为固定像素高
  height: var(--banner-h, auto);
  aspect-ratio: unquote('21 / 9');
  max-height: 56vh;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 4px 18px rgba(0, 0, 0, .12);
  // 图片加载前/加载失败时的柔和底色，避免闪白块
  background: linear-gradient(135deg, #fdeef3 0%, #f3dcf1 55%, #dfe6fb 100%);

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: banner-in .55s ease-out both;
  }

  +mobile() {
    margin: 0 0 20px;
    border-radius: 8px;
  }
}

// 夜间模式：底色同步压暗
html[data-theme='dark'] .post-banner {
  background: linear-gradient(135deg, #2b2436 0%, #33253a 55%, #232a3e 100%);
}

@keyframes banner-in {
  from {
    opacity: 0;
    transform: translateY(8px) scale(1.02);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

// 系统"减少动态效果"时取消入场动画
@media (prefers-reduced-motion: reduce) {
  .post-banner img {
    animation: none;
  }
}

// ============================================
// 全站搜索面板（Pagefind 内核 + 毛玻璃面板）
// 逻辑在 body-end.swig；构建索引用 npm run build
// ============================================

// 右下角浮动搜索按钮（与昼夜按钮上下呼应）
#search-btn {
  position: fixed;
  bottom: 80px;
  right: 24px;
  z-index: 999;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: #fff;
  color: #667;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .2);
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .2s, background .3s;

  svg {
    width: 20px;
    height: 20px;
  }

  &:hover {
    transform: scale(1.08);
  }

  &:active {
    transform: scale(.95);
  }
}

html[data-theme='dark'] #search-btn {
  background: #333;
  color: #ddd;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .5);
}

// 半透明层：只做轻微压暗，不做全屏拦截，点击它就收起面板
// 右侧抽屉式搜索：不遮挡正文，平时完全收起，需要时滑出
#search-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1200;
  background: rgba(15, 18, 26, .18);
  -webkit-backdrop-filter: blur(1.5px);
  backdrop-filter: blur(1.5px);
  // 面板靠右停靠：右内边距留出面板宽度 + 间距
  display: flex;
  justify-content: flex-end;
  align-items: stretch;
  padding: 0;
  // 整层可穿透，只有面板本身接收鼠标，正文照常滚动/选择
  pointer-events: none;
}

// 关键：hidden 属性必须压过上面的 display:flex，否则 JS 设 hidden 后面板仍显示（关不掉）
#search-overlay[hidden] {
  display: none !important;
}

// 右侧抽屉：占满高度、贴右停靠，像侧边栏一样不挡正文
.search-panel {
  width: 400px;
  max-width: 92vw;
  height: 100%;
  max-height: none;
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, .94);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  backdrop-filter: blur(18px) saturate(150%);
  border-radius: 14px 0 0 14px;
  box-shadow: -8px 0 40px rgba(0, 0, 0, .18);
  overflow: hidden;
  pointer-events: auto;
  animation: search-slide .24s cubic-bezier(.22, .61, .36, 1);
}

@keyframes search-slide {
  from {
    opacity: 0;
    transform: translateX(24px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

// 输入区
.search-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(0, 0, 0, .06);

  svg {
    width: 18px;
    height: 18px;
    color: #8a94a6;
    flex: none;
  }

  input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--text-color, #333);

    &::placeholder {
      color: #a0a8b8;
    }

    // 清掉浏览器原生 search 框样式
    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  .search-close {
    border: none;
    background: transparent;
    cursor: pointer;
    color: #8a94a6;
    font-size: 15px;
    line-height: 1;
    padding: 6px 8px;
    border-radius: 6px;

    &:hover {
      background: rgba(0, 0, 0, .06);
      color: #333;
    }
  }
}

// 结果区
.search-body {
  flex: 1;
  overflow-y: auto;
  padding: 8px;

  #search-hint {
    padding: 28px 12px;
    text-align: center;
    color: #8a94a6;
    font-size: 14px;
  }
}

#search-results {
  list-style: none;
  margin: 0;
  padding: 0;

  a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background .15s;

    &:hover,
    &.active {
      background: rgba(57, 197, 187, .12);
    }
  }

  .sr-title {
    font-weight: 600;
    font-size: 15px;
    color: var(--text-color, #333);
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sr-excerpt {
    font-size: 13px;
    color: #6b7484;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    mark {
      background: rgba(57, 197, 187, .28);
      color: inherit;
      padding: 0 2px;
      border-radius: 3px;
    }
  }
}

// 底部快捷键提示
.search-foot {
  display: flex;
  gap: 14px;
  align-items: center;
  padding: 10px 18px;
  border-top: 1px solid rgba(0, 0, 0, .06);
  font-size: 12px;
  color: #8a94a6;

  kbd {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, .15);
    border-bottom-width: 2px;
    background: #fff;
    font-size: 11px;
    font-family: inherit;
    margin: 0 2px;
  }

  #search-count {
    margin-left: auto;
  }
}

// 移动端适配：小屏抽屉占满宽度
+mobile() {
  #search-overlay {
    padding: 0;
  }

  .search-panel {
    width: 100%;
    max-width: 100%;
    border-radius: 0;
  }
}

// ============================================
// 友链页面（/links/）
// 数据：source/_data/friends.yml   渲染：scripts/friends.js
// 用 {% friends %} 可以在任意文章里插入同一面卡片墙
// ============================================
.friends-page {
  margin: 18px 0 6px;
}

.friends-group-title {
  position: relative;
  margin: 26px 0 12px;
  padding-left: 12px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .06em;
  color: #8a94a6;

  &::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 14px;
    border-radius: 2px;
    background: linear-gradient(180deg, #ffa8c4, #39c5bb);
  }

  +mobile() {
    margin: 20px 0 10px;
  }
}

.friends-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 14px;

  // pangu.js（主题的「中英文自动加空格」）会在相邻的两个 <a> 之间插入一个
  // <pangu> 占位元素，网格会把它当成一个格子，把卡片挤到后面的列去。
  // 这里把它隐藏掉，卡片就能按顺序紧凑排列。
  > pangu {
    display: none;
  }

  +mobile() {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}

// 单张卡片：毛玻璃 + 悬浮上浮
.friend-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 15px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, .72);
  background: rgba(255, 255, 255, .6);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
  backdrop-filter: blur(10px) saturate(140%);
  box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
  color: inherit;
  text-decoration: none !important;
  overflow: hidden;
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease, background .22s ease;

  &:hover {
    transform: translateY(-3px);
    border-color: rgba(57, 197, 187, .55);
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 10px 24px rgba(57, 130, 140, .16);
  }

  // 右上角小箭头：平时透明，悬浮浮现
  &::after {
    content: '↗';
    position: absolute;
    top: 8px;
    right: 10px;
    font-size: 12px;
    color: #39c5bb;
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity .22s ease, transform .22s ease;
  }

  &:hover::after {
    opacity: .9;
    transform: none;
  }

  +mobile() {
    padding: 11px 13px;
  }
}

// 头像：图片版
.friend-avatar {
  flex: none;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, .6);
  box-shadow: 0 0 0 1px rgba(0, 0, 0, .05);
  transition: transform .25s ease;

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}

.friend-card:hover .friend-avatar {
  transform: scale(1.06) rotate(-3deg);
}

// 头像：无图片时用站点名首字生成色块
.friend-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ffc9dd 0%, #cbd9ff 55%, #b6e9e4 100%);

  i {
    font-size: 20px;
    font-style: normal;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, .18);
  }
}

.friend-info {
  flex: 1;
  min-width: 0;
}

.friend-name {
  display: block;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-color, #333);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 3px;
  font-size: 12.5px;
  line-height: 1.5;
  color: #6b7484;
}

.friends-empty {
  padding: 26px 18px;
  border-radius: 12px;
  border: 1px dashed rgba(0, 0, 0, .12);
  text-align: center;
  font-size: 14px;
  color: #8a94a6;

  code {
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(57, 197, 187, .12);
    color: inherit;
  }
}

// 夜间模式适配（卡片、文字、虚线框）
html[data-theme='dark'] {
  .friend-card {
    background: rgba(58, 63, 76, .5);
    border-color: rgba(255, 255, 255, .08);
    box-shadow: 0 2px 10px rgba(0, 0, 0, .3);

    &:hover {
      background: rgba(72, 78, 94, .62);
      border-color: rgba(57, 197, 187, .5);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .4);
    }
  }

  // 夜间主题会把图片整体压暗，头像保持原亮度更好辨认
  .friend-avatar img {
    opacity: 1;
  }

  .friend-avatar {
    background: rgba(255, 255, 255, .12);
  }

  .friend-avatar--text i {
    color: #2b3140;
    text-shadow: none;
  }

  .friend-name {
    color: #e6e9ef;
  }

  .friend-desc {
    color: #9aa3b2;
  }

  .friends-group-title {
    color: #8a94a6;
  }

  .friends-empty {
    border-color: rgba(255, 255, 255, .14);
    color: #8a94a6;
  }
}

// ============================================
// 搜索面板夜间模式适配
// ============================================
html[data-theme='dark'] {
  #search-overlay {
    background: rgba(0, 0, 0, .28);
  }

  .search-panel {
    background: rgba(30, 33, 42, .94);
    box-shadow: -8px 0 40px rgba(0, 0, 0, .5);
  }

  .search-head {
    border-bottom-color: rgba(255, 255, 255, .08);

    input {
      color: #e6e9ef;

      &::placeholder {
        color: #6b7484;
      }
    }

    .search-close {
      color: #8a94a6;

      &:hover {
        background: rgba(255, 255, 255, .08);
        color: #e6e9ef;
      }
    }
  }

  #search-results {
    a {

      &:hover,
      &.active {
        background: rgba(57, 197, 187, .18);
      }
    }

    .sr-title {
      color: #e6e9ef;
    }

    .sr-excerpt {
      color: #9aa3b2;

      mark {
        background: rgba(57, 197, 187, .32);
        color: #d8f5f2;
      }
    }
  }

  .search-foot {
    border-top-color: rgba(255, 255, 255, .08);

    kbd {
      background: #3a3f4c;
      border-color: rgba(255, 255, 255, .15);
      color: #cfd4dd;
    }
  }
}

// ============================================
// 和风樱花打字机（typewriter）
// 配置：source/_data/typewriter.yml
// 脚本：source/js/typewriter.js（body-end.swig 里以 defer 引入）
// 字体：--tw-font 由 scripts/typewriter.js 的 typewriter_head() 注入
//
// 三个场景：
//   .tw--subtitle  站名下方那行副标题（窄栏、浅色小字，衬在 #222 深色块上）
//   .tw-block      {% typewriter %} 标签渲染的毛玻璃卡片
//   .tw-welcome    进场欢迎弹层（DOM 由 JS 现场创建）
// ============================================

$tw-pink      = #ffa8c4
$tw-teal      = #39c5bb
$tw-glow      = rgba(255, 168, 196, .55)

// 兜底字体栈：webfont 没加载出来就退到系统楷体，效果依然成立
:root {
  --tw-font: "LXGW WenKai", "Kaiti SC", KaiTi, STKaiti, "楷体", "Songti SC", serif;
}

.tw-text {
  font-family: var(--tw-font);
}

// ---------- 光标：粉→青渐变的小竖条，打字时常亮，停顿时呼吸闪烁 ----------
.tw-caret {
  display: inline-block;
  width: 2px;
  height: 1.02em;
  margin-left: 4px;
  vertical-align: -.14em;
  border-radius: 2px;
  background: linear-gradient(180deg, $tw-pink, $tw-teal);
  box-shadow: 0 0 6px rgba(255, 168, 196, .9), 0 0 2px rgba(57, 197, 187, .7);
  animation: tw-blink 1.15s steps(1, end) infinite;
}

.tw.is-typing .tw-caret {
  animation: none;
  opacity: 1;
}

@keyframes tw-blink {
  0%, 52% {
    opacity: 1;
  }
  53%, 100% {
    opacity: .08;
  }
}

// 换一条句子时，左边那朵樱花轻轻一跳
@keyframes tw-petal-pop {
  0% {
    transform: rotate(0deg) scale(1);
  }
  35% {
    transform: rotate(40deg) scale(1.18);
  }
  100% {
    transform: rotate(0deg) scale(1);
  }
}

// ---------- 副标题：衬在站名下方的 #222 深色块上 ----------
.tw--subtitle {
  display: block;
  min-height: 1.5em;

  .tw-text {
    color: #ffe9f2;
    letter-spacing: .05em;
    // 深底上给一点樱粉柔光，字会"浮"起来
    text-shadow: 0 0 12px $tw-glow, 0 0 2px rgba(255, 255, 255, .4);
  }

  .tw-caret {
    width: 2px;
    height: .95em;
    margin-left: 3px;
  }
}

// ---------- {% typewriter %} 卡片 ----------
.tw-block {
  position: relative;
  display: flex;
  align-items: center;
  gap: 15px;
  margin: 24px 0;
  padding: 19px 24px 19px 22px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, .72);
  background: rgba(255, 255, 255, .55);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
  backdrop-filter: blur(10px) saturate(140%);
  box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
  overflow: hidden;

  // 左侧渐变小竖条，和友链分组标题同一套语言
  &::before {
    content: '';
    position: absolute;
    left: 0;
    top: 16px;
    bottom: 16px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: linear-gradient(180deg, $tw-pink, $tw-teal);
  }

  +mobile() {
    gap: 12px;
    padding: 16px 16px 16px 18px;
    margin: 20px 0;
  }
}

// 左边的樱花
.tw-deco {
  flex: none;
  width: 30px;
  height: 30px;
  color: $tw-pink;
  filter: drop-shadow(0 2px 6px rgba(255, 138, 176, .5));

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tw-petal-core {
    fill: #fff8fb;
  }

  +mobile() {
    width: 24px;
    height: 24px;
  }
}

.tw-block.is-swap .tw-deco {
  animation: tw-petal-pop .62s ease;
}

.tw-body {
  display: block;
  min-width: 0;
}

// 打字区：留一行半高度，句子长短变化时不会把下面的内容顶来顶去
.tw-line {
  display: block;
  font-size: 1.22em;
  line-height: 1.75;
  min-height: 1.75em;
}

.tw-block {
  .tw-text {
    color: var(--text-color, #333);
    // 一层很淡的樱粉柔光，肉眼几乎看不出颜色，但字会"浮"在玻璃上
    text-shadow: 0 0 16px rgba(255, 168, 196, .38);
  }

  .tw-caret {
    width: 3px;
    height: 1.05em;
  }
}

// 「点一下，换一句」：平时淡淡的，鼠标移上去变清楚
.tw-hint {
  display: block;
  margin-top: 2px;
  font-family: var(--tw-font);
  font-size: 12px;
  letter-spacing: .04em;
  color: #9aa3b0;
  opacity: .55;
  transition: opacity .3s ease;

  &.is-hidden {
    opacity: 0;
  }
}

.tw-block:hover .tw-hint:not(.is-hidden) {
  opacity: .95;
}

// ---------- 夜间模式：卡片压暗，粉光更明显一点 ----------
html[data-theme='dark'] {
  .tw-block {
    background: rgba(52, 55, 66, .5);
    border-color: rgba(255, 255, 255, .1);
    box-shadow: 0 2px 12px rgba(0, 0, 0, .32);
  }

  .tw-block .tw-text {
    text-shadow: 0 0 14px rgba(255, 168, 196, .3);
  }

  .tw-hint {
    color: #8d93a1;
  }
}

// ---------- 进场欢迎弹层（卡片样式） ----------
// DOM 由 source/js/typewriter.js 的 setupWelcome() 现场创建，
// 所以它不会被搜索引擎 / 站内搜索收录，也不需要往模板里写任何东西。
.tw-welcome {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  // 比点击樱花特效（2147483000）低一点，比正文 / 侧栏 / 播放器都高
  z-index: 2147482000;
  // 整体不拦操作：翻页、滚动、点菜单都照常，只有卡片本身能点
  pointer-events: none;
  opacity: 0;
  transition: opacity .55s ease;

  &.is-in {
    opacity: 1;
  }

  &.is-out {
    opacity: 0;
  }
}

.tw-welcome--center {
  display: flex;
  align-items: center;
  justify-content: center;
  // 稍偏上，别正好压住正文的第一屏视觉中心
  padding: 0 20px 11vh;
}

.tw-welcome--corner {
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 84px 22px 0;
}

// 居中的那层淡樱色薄雾：看得见、点不着，不挡滚动和点击
.tw-welcome-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  background:
    radial-gradient(62% 46% at 50% 42%, rgba(255, 233, 242, .62), rgba(255, 233, 242, 0) 74%),
    linear-gradient(180deg, rgba(255, 246, 250, .34), rgba(255, 246, 250, .2));
}

// 注意：这里别写 CSS 的 min()/max()，Stylus 会当成自己的函数算掉
// （min(88vw, 460px) 会被编译成 88vw），宽+上限分开写
.tw-welcome-card {
  position: relative;
  pointer-events: auto;
  width: 88vw;
  max-width: 430px;
  padding-bottom: 20px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .85);
  background: rgba(255, 255, 255, .74);
  -webkit-backdrop-filter: blur(14px) saturate(150%);
  backdrop-filter: blur(14px) saturate(150%);
  // 一圈樱粉外发光，让卡片从背景里"浮"起来
  box-shadow: 0 18px 46px rgba(214, 143, 176, .26), 0 2px 10px rgba(0, 0, 0, .06);
  transform: translateY(20px) scale(.965);
  transition: transform .66s cubic-bezier(.16, .84, .28, 1);
}

.tw-welcome.is-in .tw-welcome-card {
  transform: none;
}

.tw-welcome--corner .tw-welcome-card {
  width: 80vw;
  max-width: 340px;
  transform: translate(20px, -12px) scale(.96);
}

// 卡片里飘的几片樱花（纯装饰）
.tw-welcome-petals {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;

  i {
    position: absolute;
    top: -14px;
    width: 9px;
    height: 9px;
    border-radius: 50% 0 50% 50%;
    background: linear-gradient(135deg, #ffc9dc, #ff9dbe);
    opacity: 0;
    animation: tw-welcome-fall 7.5s linear infinite;

    &:nth-child(1) {
      left: 14%;
      animation-delay: .2s;
      animation-duration: 7.2s;
    }

    &:nth-child(2) {
      left: 38%;
      width: 7px;
      height: 7px;
      animation-delay: 2.4s;
      animation-duration: 8.4s;
    }

    &:nth-child(3) {
      left: 63%;
      animation-delay: 4.1s;
      animation-duration: 7.8s;
    }

    &:nth-child(4) {
      left: 85%;
      width: 6px;
      height: 6px;
      animation-delay: 5.6s;
      animation-duration: 9s;
    }
  }
}

@keyframes tw-welcome-fall {
  0% {
    opacity: 0;
    transform: translate3d(0, -6px, 0) rotate(0deg);
  }
  12% {
    opacity: .75;
  }
  70% {
    opacity: .55;
  }
  100% {
    opacity: 0;
    transform: translate3d(-16px, 260px, 0) rotate(320deg);
  }
}

.tw-welcome-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 13px 14px 13px 17px;
  background: linear-gradient(90deg, rgba(255, 168, 196, .38), rgba(57, 197, 187, .24));
  border-bottom: 1px solid rgba(255, 255, 255, .68);
}

.tw-welcome-deco {
  flex: none;
  width: 21px;
  height: 21px;
  color: #ff8ab0;
  filter: drop-shadow(0 1px 5px rgba(255, 138, 176, .55));

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tw-petal-core {
    fill: #fffafc;
  }
}

.tw-welcome-title {
  flex: 1;
  min-width: 0;
  font-family: var(--tw-font);
  font-size: 15px;
  letter-spacing: .05em;
  color: #6d4553;
  text-shadow: 0 1px 0 rgba(255, 255, 255, .6);
}

.tw-welcome-close {
  flex: none;
  width: 24px;
  height: 24px;
  padding: 0;
  line-height: 1;
  font-size: 17px;
  color: #8a6472;
  cursor: pointer;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .35);
  transition: background-color .22s ease, transform .22s ease;

  &:hover {
    background: rgba(255, 255, 255, .85);
    transform: rotate(90deg);
  }
}

.tw-welcome-body {
  position: relative;
  padding: 19px 26px 2px;
}

// 留一行半的高度：写得长的欢迎语换行时不会把卡片顶来顶去
.tw-welcome .tw-line {
  display: block;
  font-size: 1.15em;
  line-height: 1.85;
  min-height: 1.9em;
}

.tw-welcome .tw-text {
  color: #46373c;
  text-shadow: 0 0 14px rgba(255, 168, 196, .42);
}

.tw-welcome .tw-caret {
  width: 3px;
  height: 1.05em;
}

// 打字过程中光标常亮（配合 JS 给卡片加的 is-typing）
.tw-welcome-card.is-typing .tw-caret {
  animation: none;
  opacity: 1;
}

.tw-welcome-foot {
  position: relative;
  margin-top: 6px;
  padding: 0 26px;
  font-family: var(--tw-font);
  font-size: 12px;
  letter-spacing: .03em;
  color: #a08b93;
}

// 夜间模式：卡片压暗，粉光更明显
html[data-theme='dark'] {
  .tw-welcome-mask {
    background:
      radial-gradient(62% 46% at 50% 42%, rgba(120, 72, 92, .5), rgba(120, 72, 92, 0) 74%),
      linear-gradient(180deg, rgba(28, 26, 32, .42), rgba(28, 26, 32, .28));
  }

  .tw-welcome-card {
    background: rgba(46, 44, 54, .78);
    border-color: rgba(255, 255, 255, .12);
    box-shadow: 0 18px 46px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 168, 196, .1);
  }

  .tw-welcome-head {
    background: linear-gradient(90deg, rgba(255, 168, 196, .3), rgba(57, 197, 187, .2));
    border-bottom-color: rgba(255, 255, 255, .1);
  }

  .tw-welcome-title {
    color: #ffdcea;
    text-shadow: 0 0 12px rgba(255, 168, 196, .35);
  }

  .tw-welcome-close {
    color: #e9d3dd;
    background: rgba(255, 255, 255, .08);

    &:hover {
      background: rgba(255, 255, 255, .2);
    }
  }

  .tw-welcome .tw-text {
    color: #f2e9ee;
    text-shadow: 0 0 14px rgba(255, 168, 196, .32);
  }

  .tw-welcome-foot {
    color: #a89aa3;
  }
}

// 手机端：卡片宽一点、字小一点、离顶部近一点
+mobile() {
  .tw-welcome--center {
    padding: 0 16px 6vh;
  }

  .tw-welcome--corner {
    padding: 68px 14px 0;
  }

  .tw-welcome-card {
    width: 92vw;
    max-width: 92vw;
    border-radius: 14px;
  }

  .tw-welcome-body {
    padding: 17px 18px 2px;
  }

  .tw-welcome-foot {
    padding: 0 18px;
  }

  .tw-welcome .tw-line {
    font-size: 1.06em;
    min-height: 1.9em;
  }
}

// ---------- 系统开了「减少动态效果」：只留静态第一句，不闪不跳 ----------
@media (prefers-reduced-motion: reduce) {
  .tw-caret {
    animation: none;
  }

  .tw-block.is-swap .tw-deco {
    animation: none;
  }

  .tw-welcome-petals i {
    animation: none;
    opacity: 0;
  }

  .tw-welcome-card,
  .tw-welcome.is-in .tw-welcome-card {
    transition: none;
    transform: none;
  }
}

